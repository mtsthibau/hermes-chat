{
  "name": "hermes",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:chat": "turbo run dev --filter=hermes-chat",
    "dev:gps":  "turbo run dev --filter=hermes-gps",
    "dev":      "turbo run dev",
    "build":    "turbo run build",
    "lint":     "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
